    </annotation>
    <restriction base="string">
      <enumeration value="Jord">
        <annotation>
          <documentation>topplaget på jordoverflaten som består av løsmasse</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Lyd">
        <annotation>
          <documentation>uønsket lyd eller støy</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Naturressurser">
        <annotation>
          <documentation>en del av det naturlige miljøet som er av verdi for menneskelige behov. For eksempel jord, vann, flora, fauna</documentation>
        </annotation>
      </enumeration>
      <enumeration value="KlimaOgKlimaendringer">
        <annotation>
          <documentation>gjeldende klimasituasjon eller endringer over tid</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Helsebeskyttelse">
        <annotation>
          <documentation>tiltak for å redusere helseskadelige faktorer</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Luft">
        <annotation>
          <documentation>en miks av ulike gasser som danner jordens atmosfære</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Vann">
        <annotation>
          <documentation>væske (H&lt;sub&gt;2&lt;/sub&gt;O) som er utgangspunkt for regn, elver, havet osv.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Avfall">
        <annotation>
          <documentation>gjenstander, materialer, restprodukter eller energibærere som ikke lenger har sin opprinnelige verdi</documentation>
        </annotation>
      </enumeration>
      <enumeration value="NaturOgBiologiskMangfold">
        <annotation>
          <documentation>aktiv administrasjon av jordens naturressurser og miljø for å forsikre at deres kvalitet blir opprettholdt og at områdene blir brukt på en fornuftig måte</documentation>
        </annotation>
      </enumeration>
      <enumeration value="BærekraftigUtvikling">
        <annotation>
          <documentation>utvikling som sørger for økonomiske, sosiale og miljømessige fordeler i det lange løp for å sikre behovene til levende og fremtidige generasjoner</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Arealbruk">
        <annotation>
          <documentation>det romlige aspektet av all menneskelig aktivitet på landområder og hvordan områdene er eller kan bli tilpasset til å dekke menneskelige behov</documentation>
        </annotation>
      </enumeration>
    </restriction>
