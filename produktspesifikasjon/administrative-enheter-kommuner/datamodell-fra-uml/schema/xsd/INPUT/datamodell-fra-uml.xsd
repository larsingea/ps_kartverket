                <sc:taggedValue tag="SOSI_navn">GRENSEMERKENUMMER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="avstandNorskStolpe" type="double">
            <annotation>
              <documentation>plan, horisontal avstand i meter fra grensemerket til tilhørende grensestolpe på norsk side av riksgrensa</documentation>
