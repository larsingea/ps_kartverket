    <annotation>
      <documentation>type administrasjon, regulering eller restriksjon som gjelder innenfor det angitte området</documentation>
    </annotation>
    <union memberTypes="datamodellfrauml:SonetypeEnumerationType datamodellfrauml:SonetypeOtherType"/>
  </simpleType>
  <simpleType name="SonetypeEnumerationType">
    <annotation>
      <documentation>type administrasjon, regulering eller restriksjon som gjelder innenfor det angitte området</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="LuftkvalitetAdministrativSone">
        <annotation>
          <documentation>et avgrenset område brukt av staten til å vurdere og administrere luftkvaliteten</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Lydrestriksjonssone">
        <annotation>
          <documentation>et område som er avgrenset av ansvarlig myndighet for å administrere og redusere støyforurensning</documentation>
        </annotation>
      </enumeration>
      <enumeration value="RestriksjonssoneForDyresykdommer">
        <annotation>
          <documentation>restriksjonsområde opprettet for kontroll og utrydding av meldepliktige dyresykdommer</documentation>
        </annotation>
      </enumeration>
      <enumeration value="TillatelsesområdeForProspekteringOgGruvedrift">
        <annotation>
          <documentation>område hvor det er gitt autorisasjon til å lete etter eller utvinne mineraler</documentation>
        </annotation>
      </enumeration>
      <enumeration value="RegulertFarled">
        <annotation>
          <documentation>navigasjonsområder i innsjø eller hav som er brukt til å organisere trafikk, hindre ulykker og forurensning, og for å støtte administrering og planlegging</documentation>
        </annotation>
      </enumeration>
      <enumeration value="RestriksjonssoneRundtForurensetGrunn">
        <annotation>
          <documentation>sone opprettet for å beskytte helsen til mennesker, dyr eller planter, og for å kontrollere utviklingen innenfor det forurensede området</documentation>
        </annotation>
      </enumeration>
      <enumeration value="OmrådeForDeponeringAvAvfall">
        <annotation>
          <documentation>område berørt av deponering av avfall</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Kystsoneforvaltning">
        <annotation>
          <documentation>område for forvaltning av integrert kystsone</documentation>
        </annotation>
      </enumeration>
      <enumeration value="VerneområdeForDrikkevann">
        <annotation>
          <documentation>område hvor lekkasje av avløpsvann, bruk av gjødsel eller sprøytemidler, eller etablering av avfallsområder er forbudt</documentation>
        </annotation>
      </enumeration>
      <enumeration value="SårbartOmråde">
        <annotation>
          <documentation>arealer som drenerer inn forurenset eller truet farvann og som bidrar til nitratforurensning, og er definert i forhold til Nitratdirektivet</documentation>
        </annotation>
      </enumeration>
      <enumeration value="MaritimtOmråde">
        <annotation>
          <documentation>havområde angitt av internasjonal havrett, hvor nasjonen har egen lovgivning knyttet til forvaltning og regulering</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Nedbørsfelt">
        <annotation>
          <documentation>område bestående av hav og land, med ett eller flere nedbørsfelt og med tilhørende grunnvann og kystnære farvann</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Badevann">
        <annotation>
          <documentation>kystnære farvann, innsjø eller elv som er spesielt godkjent, eller ikke forbudt til rekreasjonsbading av et stort antall mennesker</documentation>
        </annotation>
      </enumeration>
      <enumeration value="FlomAdministrasjonsenhet">
        <annotation>
          <documentation>når forvaltningen av et nedbørsfelt blir styrt av en overordnet enhet, for forvaltning av blant annet flomrisiko</documentation>
        </annotation>
      </enumeration>
      <enumeration value="VannmasseUnderVanndirektivet">
        <annotation>
          <documentation>en sammenhengende vannforekomst innenfor et nedbørsfelt, hvor miljømålene til EUs Vanndirektiv må gjelde</documentation>
        </annotation>
      </enumeration>
      <enumeration value="SensitivtVannområde">
        <annotation>
          <documentation>vannområder som er identifisert som sensitive områder</documentation>
        </annotation>
      </enumeration>
      <enumeration value="AngittFarvann">
        <annotation>
          <documentation>havområder som er angitt til å trenge beskyttelse eller forbedring for å støtte fiskebestander</documentation>
        </annotation>
      </enumeration>
      <enumeration value="VernesoneForPlanteliv">
        <annotation>
          <documentation>vernesone hvor det er etablert beskyttelsestiltak mot innføring av, eller spredning av, organismer som er skadelige for planter eller planteprodukter</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Skogforvaltningsområde">
        <annotation>
          <documentation>areal for en bærekraftig forvaltning av skogsressurser</documentation>
        </annotation>
      </enumeration>
    </restriction>
