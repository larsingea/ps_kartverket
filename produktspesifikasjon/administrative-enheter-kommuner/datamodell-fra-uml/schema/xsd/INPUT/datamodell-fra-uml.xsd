    <restriction base="string">
      <enumeration value="AnnenDetalj">
        <annotation>
          <documentation>Grensemerket ligger i annen, uspesifisert detalj.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Annet">
        <annotation>
          <documentation>Markering av grensemerket faller utenfor de definerte.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Asfaltspiker">
        <annotation>
          <documentation>Markering av typen asfaltspiker.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Bolt">
        <annotation>
          <documentation>Markering av typen bolt uten at bolttypen er nærmere angitt.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Borehull">
        <annotation>
          <documentation>Markering av typen borehull.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Djupålen">
        <annotation>
          <documentation>Grensepunktet er i djupålen av elv eller bekk.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Fastmerke">
        <annotation>
          <documentation>Et geodetisk fastmerke er valg til grensemerke. (Grensepunktet sammenfaller med fastmerket)</documentation>
        </annotation>
      </enumeration>
      <enumeration value="GeometriskHjelpepunkt">
        <annotation>
          <documentation>Punkt som blir generert der grense eller hjelpelinje (f.eks vannkant/sti) møter annen teiggrense og det ikke er merket/målt inn noe grensepunkt. I noen tilfeller er skjæringspunkt aktuelt (jordskifte, mot riksgrense) Geometrisk hjelpepunkt blir også benyttet der øyer eller fiktive teigavgrensinger "biter seg i halen" (knutepunkt") eller tangerer annen teiggrense</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Gjerdestolpe">
        <annotation>
          <documentation>Markering av typen gjerdestolpe.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Grensepåle">
        <annotation>
          <documentation>Markering av typen grensepåle.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="GrensesteinEllerRøys">
        <annotation>
          <documentation>Markering av typene stein eller røys.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Grensetre">
        <annotation>
          <documentation>Markering av typen grensetre.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Hushjørne">
        <annotation>
          <documentation>Grensepunktet ligger i hushjørne.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Kamjern">
        <annotation>
          <documentation>Markering av typen kamjern.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="Kors">
