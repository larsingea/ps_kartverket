            <annotation>
              <documentation>henviser til fastsettings- eller lovinformasjon</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">DOKUMENTASJONSREFERANSE</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
