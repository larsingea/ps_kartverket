          <element maxOccurs="unbounded" minOccurs="0" name="sjørøys" type="datamodellfrauml:SjørøysPropertyType"/>
          <element maxOccurs="unbounded" minOccurs="0" name="grensebøye" type="datamodellfrauml:GrensebøyePropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
