              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="grensestatus" type="datamodellfrauml:GrensestatusType">
            <annotation>
              <documentation>juridisk status på grensa</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">GRENSESTATUS</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="fastsettingstype" type="datamodellfrauml:FastsettingstypeType">
