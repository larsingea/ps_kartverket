     <sc:properties>
      <sc:Property>
       <sc:name>FørsteNivå</sc:name>
       <sc:id>C148_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>den overordnede inndelingen, gjerne på nasjonalt plan

For eksempel: Nasjon
For eksempel: hele området hvor en etat skal utøve sin myndighetsrolle</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
