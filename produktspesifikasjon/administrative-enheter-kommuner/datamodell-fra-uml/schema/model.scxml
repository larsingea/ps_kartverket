    <sc:Class>
     <sc:name>NøyaktighetsklasseKode</sc:name>
     <sc:id>C145</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Klassifikasjon av stedfestingsnøyaktighet på teiggrensepunkt er basert på kodet nøyaktighet på teiggrensepunktene.

Klassifikasjon av stedfestingsnøyaktighet på grenser er basert på dårligste nøyaktighet til grensepunktene til grensen.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>NøyaktigeMålinger</sc:name>
       <sc:id>C145_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Nøyaktige målinger

Utvalg: S&lt;= 10 cm. S er (antatt) standardavvik</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>MiddelsNøyaktigeOgTransformerteMålinger</sc:name>
       <sc:id>C145_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Middels nøyaktige målinger og gamle nøyaktige målinger som er transformerte

Utvalg: S&gt;10 og S&lt;=30 cm. S er (antatt) standardavvik</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>MindreNøyaktigeMålingerOgGrenserFraTK</sc:name>
       <sc:id>C145_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Mindre nøyaktige målinger og grenser hentet fra tekniske kart

Utvalg: S&gt;30 og S&lt;200 cm. S er (antatt) standardavvik</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>MindreNøyaktigeGrenserOgGrenserFraØK</sc:name>
       <sc:id>C145_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Mindre nøyaktige grenser og grenser hentet fra kartserien Økonomisk kartverk (M: 5000)

Utvalg: S&gt;=200 og S&lt;500 cm. S er (antatt) standardavvik</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>LiteNøyaktigeGrenserOgGrenserFraN50</sc:name>
       <sc:id>C145_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lite nøyaktige grenser og grenser hentet fra kartserien Norge 1:50 000

Utvalg: S&gt;= 500 cm og målemetode er ikke lik 80, 81 eller 82 (skisserte data). S er (antatt) standardavvik</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>SkisserteGrenser</sc:name>
       <sc:id>C145_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Skisserte data.

Utvalg: S&gt;=500  og Målemetode =80, 81 eller 82 (skisserte data). S er (antatt) standardavvik.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>IngenNøyaktighet</sc:name>
       <sc:id>C145_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Data uten nøyaktighet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
