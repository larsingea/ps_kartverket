     <sc:classes>
      <sc:Class>
       <sc:name>Sektorlokalitet</sc:name>
       <sc:id>C44</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>viktig lokalitet med sentral funksjon enten knyttet til administrasjon eller utførelse av etatens eller institusjonens oppgaver</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>SEKTORLOKALITET</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:supertypes>
        <sc:SupertypeId>C47</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>posisjon</sc:name>
         <sc:id>C44_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>sted som objektet eksisterer på</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>Punkt</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>navn</sc:name>
         <sc:id>C44_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>navnet på lokaliteten, eller stedsnavn hvor lokaliteten befinner seg</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
