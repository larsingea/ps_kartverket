       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>stolpe i komposittmateriale som alltid opptrer i par, en på norsk og en på russisk side, og som sammen definerer grensemerke på profilen mellom dem</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
