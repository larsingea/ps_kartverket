    <sc:Class>
     <sc:name>Sonetype</sc:name>
     <sc:id>C169</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>type administrasjon, regulering eller restriksjon som gjelder innenfor det angitte området</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>false</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
       <sc:name>LuftkvalitetAdministrativSone</sc:name>
       <sc:id>C169_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>et avgrenset område brukt av staten til å vurdere og administrere luftkvaliteten</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lydrestriksjonssone</sc:name>
       <sc:id>C169_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>et område som er avgrenset av ansvarlig myndighet for å administrere og redusere støyforurensning</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>RestriksjonssoneForDyresykdommer</sc:name>
       <sc:id>C169_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>restriksjonsområde opprettet for kontroll og utrydding av meldepliktige dyresykdommer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>TillatelsesområdeForProspekteringOgGruvedrift</sc:name>
       <sc:id>C169_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område hvor det er gitt autorisasjon til å lete etter eller utvinne mineraler</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>RegulertFarled</sc:name>
       <sc:id>C169_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navigasjonsområder i innsjø eller hav som er brukt til å organisere trafikk, hindre ulykker og forurensning, og for å støtte administrering og planlegging</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>RestriksjonssoneRundtForurensetGrunn</sc:name>
       <sc:id>C169_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>sone opprettet for å beskytte helsen til mennesker, dyr eller planter, og for å kontrollere utviklingen innenfor det forurensede området</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>OmrådeForDeponeringAvAvfall</sc:name>
       <sc:id>C169_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område berørt av deponering av avfall</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Kystsoneforvaltning</sc:name>
       <sc:id>C169_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område for forvaltning av integrert kystsone</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>VerneområdeForDrikkevann</sc:name>
       <sc:id>C169_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område hvor lekkasje av avløpsvann, bruk av gjødsel eller sprøytemidler, eller etablering av avfallsområder er forbudt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>SårbartOmråde</sc:name>
       <sc:id>C169_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>arealer som drenerer inn forurenset eller truet farvann og som bidrar til nitratforurensning, og er definert i forhold til Nitratdirektivet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>MaritimtOmråde</sc:name>
       <sc:id>C169_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>havområde angitt av internasjonal havrett, hvor nasjonen har egen lovgivning knyttet til forvaltning og regulering</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Nedbørsfelt</sc:name>
       <sc:id>C169_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område bestående av hav og land, med ett eller flere nedbørsfelt og med tilhørende grunnvann og kystnære farvann</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Badevann</sc:name>
       <sc:id>C169_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kystnære farvann, innsjø eller elv som er spesielt godkjent, eller ikke forbudt til rekreasjonsbading av et stort antall mennesker</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>FlomAdministrasjonsenhet</sc:name>
       <sc:id>C169_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>når forvaltningen av et nedbørsfelt blir styrt av en overordnet enhet, for forvaltning av blant annet flomrisiko</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>VannmasseUnderVanndirektivet</sc:name>
       <sc:id>C169_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>en sammenhengende vannforekomst innenfor et nedbørsfelt, hvor miljømålene til EUs Vanndirektiv må gjelde</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>15</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>SensitivtVannområde</sc:name>
       <sc:id>C169_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>vannområder som er identifisert som sensitive områder</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>16</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>AngittFarvann</sc:name>
       <sc:id>C169_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>havområder som er angitt til å trenge beskyttelse eller forbedring for å støtte fiskebestander</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>17</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>VernesoneForPlanteliv</sc:name>
       <sc:id>C169_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>vernesone hvor det er etablert beskyttelsestiltak mot innføring av, eller spredning av, organismer som er skadelige for planter eller planteprodukter</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>18</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skogforvaltningsområde</sc:name>
       <sc:id>C169_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>areal for en bærekraftig forvaltning av skogsressurser</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>19</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Miljøområde</sc:name>
     <sc:id>C170</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>tematisk miljø innenfor et område som er under en gitt administrasjon, regulering eller restriksjon</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>false</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
     <sc:properties>
      <sc:Property>
       <sc:name>Jord</sc:name>
       <sc:id>C170_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>topplaget på jordoverflaten som består av løsmasse</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lyd</sc:name>
       <sc:id>C170_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>uønsket lyd eller støy</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Naturressurser</sc:name>
       <sc:id>C170_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>en del av det naturlige miljøet som er av verdi for menneskelige behov. For eksempel jord, vann, flora, fauna</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>KlimaOgKlimaendringer</sc:name>
       <sc:id>C170_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>gjeldende klimasituasjon eller endringer over tid</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Helsebeskyttelse</sc:name>
       <sc:id>C170_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>tiltak for å redusere helseskadelige faktorer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Luft</sc:name>
       <sc:id>C170_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>en miks av ulike gasser som danner jordens atmosfære</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Vann</sc:name>
       <sc:id>C170_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>væske (H&lt;sub&gt;2&lt;/sub&gt;O) som er utgangspunkt for regn, elver, havet osv.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avfall</sc:name>
       <sc:id>C170_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>gjenstander, materialer, restprodukter eller energibærere som ikke lenger har sin opprinnelige verdi</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>NaturOgBiologiskMangfold</sc:name>
       <sc:id>C170_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>aktiv administrasjon av jordens naturressurser og miljø for å forsikre at deres kvalitet blir opprettholdt og at områdene blir brukt på en fornuftig måte</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>BærekraftigUtvikling</sc:name>
       <sc:id>C170_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>utvikling som sørger for økonomiske, sosiale og miljømessige fordeler i det lange løp for å sikre behovene til levende og fremtidige generasjoner</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Arealbruk</sc:name>
       <sc:id>C170_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>det romlige aspektet av all menneskelig aktivitet på landområder og hvordan områdene er eller kan bli tilpasset til å dekke menneskelige behov</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>SpesialisertSonetype</sc:name>
     <sc:id>C171</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>tilleggsklassifisering for sonetypen

Merknad: Dataeier kan selv definere verdier som skal være gyldige i denne kodelista. Det gjøres ved å definere realiserbare subtyper av denne kodelista i en produktspesifikasjon.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
    </sc:Class>
