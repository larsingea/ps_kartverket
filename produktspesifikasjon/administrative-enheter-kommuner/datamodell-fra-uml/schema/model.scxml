      <sc:Class>
       <sc:name>Skolekrets</sc:name>
       <sc:id>C41</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>skolekretsene brukes av de fleste kommuner til å dele kommunen inn i områder som skal sogne til den enkelte skole på barne- og/eller ungdomstrinnet

Merknad: Består som oftest av hele grunnkretser selv om dette i praksis kan avvikes fra år til år.  Grensene ligger som oftest fast, men mange kommuner opererer med 'flytende' grenser.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>SKOLEKRETS</sc:Value>
         </sc:values>
        </sc:TaggedValue>
