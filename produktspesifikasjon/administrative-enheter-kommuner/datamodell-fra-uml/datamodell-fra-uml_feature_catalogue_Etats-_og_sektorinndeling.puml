@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Administrative enheter kommuner - Datamodell fra UML - Etats-_og_sektorinndeling

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Etats-_og_sektorinndeling" {

  class Sektorlokalitet <<featureType>> {
    + posisjon [1] : Punkt
    + navn [0..1] : CharacterString
    + funksjon [0..1] : CharacterString
  }

  class Sektorgrense <<featureType>> {
    + grense [1] : Kurve
    + følgerAdministrativGrense [0..1] : AdministrativGrenseKode
  }

  class "Sektorområde" as Sektoromr_de <<featureType>> {
    + område [0..*] : Flate
    + posisjon [0..*] : Punkt
    + sektornivå [0..1] : Sektornivå
    + sektoreier [0..1] : CharacterString
    + sektorId [1] : SektorId
  }

  abstract class Supertype_SOSI_Objekt_Etats_og_sektorinndeling_grenser <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + datafangstdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + sluttdato [0..1] : Date
    + gyldigFra [0..1] : Date
    + gyldigTil [0..1] : Date
    + datauttaksdato [0..1] : Date
    + endringsflagg [0..1] : Endringsflagg
    + kvalitet [1] : Posisjonskvalitet
    + opphav [0..1] : CharacterString
    + informasjon [0..*] : CharacterString
    + registreringsversjon [0..1] : Registreringsversjon
    + kopidata [0..1] : Kopidata
  }

  abstract class Supertype_SOSI_Objekt_Etats_og_Sektorinndeling <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + datafangstdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + sluttdato [0..1] : Date
    + gyldigFra [0..1] : Date
    + gyldigTil [0..1] : Date
    + datauttaksdato [0..1] : Date
    + endringsflagg [0..1] : Endringsflagg
    + opphav [0..1] : CharacterString
    + kommunenummer [0..*] : Kommunenummer
    + informasjon [0..*] : CharacterString
    + registreringsversjon [0..1] : Registreringsversjon
    + kopidata [0..1] : Kopidata
  }

  class "Sektornivå" as Sektorniv_ <<dataType>> {
    + nivånummer [0..1] : Nivånummer
    + nivånavn [0..1] : CharacterString
  }

  class SektorId <<dataType>> {
    + sektornavn [0..1] : CharacterString
    + sektornummer [0..1] : CharacterString
    + alternativtSektornummer [0..1] : CharacterString
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
    + versjonId [0..1] : CharacterString
  }

  class Endringsflagg <<dataType>> {
    + typeEndring [1] : TypeEndring
    + tidspunktEndring [1] : Date
  }

  class Posisjonskvalitet <<dataType>> {
    + målemetode [1] : Målemetode
    + nøyaktighet [0..1] : Integer
  }

  class Registreringsversjon <<dataType>> {
    + produkt [1] : CharacterString
    + versjon [1] : CharacterString
  }

  class Kopidata <<dataType>> {
    + områdeId [1] : Integer
    + originalDatavert [1] : CharacterString
    + kopidato [1] : Date
  }
}

Supertype_SOSI_Objekt_Etats_og_sektorinndeling_grenser <|-- Sektorlokalitet
Supertype_SOSI_Objekt_Etats_og_sektorinndeling_grenser <|-- Sektorgrense
Supertype_SOSI_Objekt_Etats_og_Sektorinndeling <|-- Sektoromr_de
Sektoromr_de --> Sektorlokalitet : sektorlokalitet [0..*]
Sektoromr_de --> Sektorgrense : sektorgrense [0..*]

@enduml
