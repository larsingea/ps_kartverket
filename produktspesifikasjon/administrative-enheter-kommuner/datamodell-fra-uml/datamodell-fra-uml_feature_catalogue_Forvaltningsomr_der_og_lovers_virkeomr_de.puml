@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Administrative enheter kommuner - Datamodell fra UML - Forvaltningsområder_og_lovers_virkeområde

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Forvaltningsområder_og_lovers_virkeområde" {

  class "LovVirkeområdeGrense" as LovVirkeomr_deGrense <<featureType>> {
    + grense [1] : Kurve
    + grensestatus [0..1] : Grensestatus
    + fastsettingstype [0..1] : Fastsettingstype
    + soneNautisk [0..1] : Integer
    + følgerAdministrativGrense [0..1] : AdministrativGrenseKode
  }

  class "LovVirkeområdeGrensePunkt" as LovVirkeomr_deGrensePunkt <<featureType>> {
    + posisjon [1] : Punkt
    + punktreferanse [0..*] : Punktreferanse
  }

  class "LovVirkeområde" as LovVirkeomr_de <<featureType>> {
    + område [0..*] : Flate
    + posisjon [0..*] : Punkt
    + sonetype [0..*] : Sonetype
    + miljøområde [0..*] : Miljøområde
    + spesialisertSonetype [0..1] : SpesialisertSonetype
  }

  abstract class "Virkeområde" as Virkeomr_de <<featureType>> {
    + dokumentasjonsreferanse [1..*] : Dokumentasjonsreferanse
    + ansvarligMyndighet [0..*] : CharacterString
    + gjelderOmråde [0..1] : CharacterString
    + virkeområdenavn [0..1] : CharacterString
  }

  abstract class "Supertype_SOSI_Objekt_Lov_virkeområde" as Supertype_SOSI_Objekt_Lov_virkeomr_de <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + datafangstdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + sluttdato [0..1] : Date
    + gyldigFra [0..1] : Date
    + gyldigTil [0..1] : Date
    + datauttaksdato [0..1] : Date
    + endringsflagg [0..1] : Endringsflagg
    + kvalitet [1] : Posisjonskvalitet
    + opphav [0..1] : CharacterString
    + kommunenummer [0..*] : Kommunenummer
    + informasjon [0..*] : CharacterString
    + registreringsversjon [0..1] : Registreringsversjon
    + kopidata [0..1] : Kopidata
  }

  class Punktreferanse <<dataType>> {
    + grenselinjeidentifikasjon [0..*] : Identifikasjon
    + punktnummer [0..1] : CharacterString
    + punktnavn [0..1] : CharacterString
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
    + versjonId [0..1] : CharacterString
  }

  class Dokumentasjonsreferanse <<dataType>> {
    + rettskildeTittel [1] : CharacterString
    + rettskildeId [0..1] : CharacterString
    + hjemmel [0..1] : CharacterString
    + fastsettingsmyndighet [0..1] : CharacterString
    + fastsettingsdato [1] : Date
    + dokumentlink [0..*] : CharacterString
    + internReferanseKartverket [0..*] : CharacterString
  }

  class Endringsflagg <<dataType>> {
    + typeEndring [1] : TypeEndring
    + tidspunktEndring [1] : Date
  }

  class Posisjonskvalitet <<dataType>> {
    + målemetode [1] : Målemetode
    + nøyaktighet [0..1] : Integer
  }

  class Registreringsversjon <<dataType>> {
    + produkt [1] : CharacterString
    + versjon [1] : CharacterString
  }

  class Kopidata <<dataType>> {
    + områdeId [1] : Integer
    + originalDatavert [1] : CharacterString
    + kopidato [1] : Date
  }
}

Virkeomr_de <|-- LovVirkeomr_deGrense
LovVirkeomr_deGrense --> LovVirkeomr_deGrensePunkt : lovVirkeområdeGrensePunkt [0..*]
Supertype_SOSI_Objekt_Lov_virkeomr_de <|-- LovVirkeomr_deGrensePunkt
Virkeomr_de <|-- LovVirkeomr_de
LovVirkeomr_de --> LovVirkeomr_deGrense : virkeområdegrense [0..*]
Supertype_SOSI_Objekt_Lov_virkeomr_de <|-- Virkeomr_de

@enduml
