       <sc:id>C26_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>hentet fra AIXM 5.1 klasse CodeVerticalStructureType kode FENCE</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
