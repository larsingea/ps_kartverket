      <sc:Property>
       <sc:name>Lavintensitet type A</sc:name>
       <sc:id>C35_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>rødt, fast, 10 candela</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lavintensitet type B</sc:name>
       <sc:id>C35_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>rødt, fast, 32 candela</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lavintensitet type C</sc:name>
       <sc:id>C35_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>ikke del av oversikten i vedlegg 2 BSL E 2-1, men tatt fra tabell 6-3 i ICAO annex 14</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
