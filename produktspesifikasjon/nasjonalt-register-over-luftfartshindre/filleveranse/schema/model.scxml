         <sc:descriptorValues>
          <sc:DescriptorValue>hentet fra AIXM 5.1 klasse CodeVerticalStructureType

gjelder også heisekrantypene skinnekran/havnekran, tårnkran/byggekran, mobilkran, flytekran</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
