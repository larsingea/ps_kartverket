         <sc:descriptorValues>
          <sc:DescriptorValue>hvitt, blinkende, 20 000 candela ved bakgrunnsbelysning 50 cd/m ² og over, 2000 candela med bakgrunnsbelysning uneder 50 cd/m ²</sc:DescriptorValue>
         </sc:descriptorValues>
