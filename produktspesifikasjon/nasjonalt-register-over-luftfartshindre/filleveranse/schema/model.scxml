       <sc:id>C26_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>hentet fra AIXM 5.1 klasse CodeVerticalStructureType kode LIGHTHOUSE</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Monument</sc:name>
       <sc:id>C26_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>hentet fra AIXM 5.1 klasse CodeVerticalStructureType, kode MONUMENT</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Terrengpunkt</sc:name>
       <sc:id>C26_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>hentet fra AIXM 5.1 klasse CodeVerticalStructureType, kode NATURAL_HIGHPOINT</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>15</sc:sequenceNumber>
