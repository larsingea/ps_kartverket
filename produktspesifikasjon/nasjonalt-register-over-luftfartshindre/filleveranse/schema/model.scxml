     <sc:name>Høydereferansesystem</sc:name>
     <sc:id>C19</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>referanseflate som er utgangspunktet for høydekoordinat.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>Ellipsoide jf. KOORDSYS</sc:name>
       <sc:id>C19_1</sc:id>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lokal referanseflate</sc:name>
       <sc:id>C19_2</sc:id>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Geoide bestemt av NKG i 1989</sc:name>
       <sc:id>C19_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>NKG: The Nordic Geodetic Commission - founded in 1953 - is an association of geodesists from Denmark, Finland, Iceland, Norway and Sweden. Its purpose is to give the members possibilities of fruitful gatherings and mutual exchange of professional views and experiences. The NKG is recognized and supported by a number of Nordic  organizations, such as the Director Generals of the Nordic Mapping Authorities. (Kilde: http://217.152.180.26/nkg/)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Norsk Null av 1954</sc:name>
       <sc:id>C19_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Denne er identisk med NN1954</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Nord-Norsk Null av 1957</sc:name>
       <sc:id>C19_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>For nyere data er denne gått ut av bruk. Er erstattet av NN54.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Norsk Null av 2000</sc:name>
       <sc:id>C19_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Nytt felles nordisk vertikalt datum, basert på Normaal Amsterdals Peil.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
