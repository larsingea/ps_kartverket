@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title N50 Kartdata - DGIF - Høyde

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Høyde" {

  class "Høydekurve" as H_ydekurve <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_elevationSurfaceCategory [1] : CharacterString
    + dgif_hypsographyPortrayalType [1] : CharacterString
    + dgif_elevationMsl [1] : Integer
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + senterlinje [1] : GM_Curve
    + høydekurvetype [1] : Høydekurvetype
    + høyde [1] : Integer
    + medium [1] : MediumHøyde
  }

  class Terrengpunkt <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_elevationSurfaceCategory [1] : CharacterString
    + dgif_elevationMsl [1] : Integer
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + posisjon [1] : GM_Point
    + høydepunkttype [1] : Høydepunkttype
    + høyde [1] : Integer
    + medium [1] : MediumHøyde
  }

  class Trigonometriskpunkt <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatyreType531 [1] : CharacterString
    + dgif_elevationSurfaceCategory [1] : CharacterString
    + dgif_SurveyPointType [1] : CharacterString
    + dgif_elevationMsl [1] : Integer
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + posisjon [1] : GM_Point
    + høydepunkttype [1] : Høydepunkttype
    + høyde [1] : Integer
    + medium [1] : MediumHøyde
  }
}

package "Eksterne referanser" <<Frame>> {
  class "KvalitetPåkrevd" as KvalitetP_krevd <<Generelle typer>> {
  }
}

KvalitetP_krevd <|-- H_ydekurve
KvalitetP_krevd <|-- Terrengpunkt
KvalitetP_krevd <|-- Trigonometriskpunkt

@enduml
