@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title N50 Kartdata - DGIF - Hydrografi

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Hydrografi" {

  class KonnekteringVann <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + senterlinje [1] : GM_Curve
  }

  class ElvBekk <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + senterlinje [1] : GM_Curve
    + vannbredde [1] : VannBredde
  }

  class "Flomløpkant" as Floml_pkant <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + grense [1] : GM_Curve
  }

  class "MidtlinjeElvInnsjø" as MidtlinjeElvInnsj_ <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + senterlinje [1] : GM_Curve
  }

  class "Skjær" as Skj_r <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + posisjon [1] : GM_Point
  }

  class Foss <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + posisjon [1] : GM_Point
    + retning [1] : Retning
  }

  class Kystkontur <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_currencyDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + grense [1] : GM_Curve
  }

  class "KanalGrøft" as KanalGr_ft <<featureType>> {
    + dgif_FeatureType [1] : CharacterString
    + dgif_FeatureType531 [1] : CharacterString
    + dgif_modificationDateTime [1] : Date
    + dgif_sourceIdentifier [1] : CharacterString
    + senterlinje [0..1] : Kurve
    + dgif_currencyDateTime [1] : Date
    + vannBredde [1] : VannBredde
  }

  class Retning <<dataType>> {
    + retningsverdi [1] : Real
    + retningsenhet [1] : Retningsenhet
    + retningsreferanse [1] : Retningsreferanse
  }
}

package "Eksterne referanser" <<Frame>> {
  class "KvalitetPåkrevd" as KvalitetP_krevd <<Generelle typer>> {
  }
}

KvalitetP_krevd <|-- KonnekteringVann
KvalitetP_krevd <|-- ElvBekk
KvalitetP_krevd <|-- Floml_pkant
KvalitetP_krevd <|-- MidtlinjeElvInnsj_
KvalitetP_krevd <|-- Skj_r
KvalitetP_krevd <|-- Foss
KvalitetP_krevd <|-- Kystkontur
KvalitetP_krevd <|-- KanalGr_ft

@enduml
